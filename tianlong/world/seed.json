  "nodes": {
    "剑湖宫":   {"type": "location", "region": "大理·无量山", "desc": "无量剑东宗所居，练武厅宽敞，正值五年一度比剑之期，宾客云集。",
                 "lore": ["无量剑分东、北、西三宗，北宗早已式微；东西二宗每五年在剑湖宫比剑，胜者入住剑湖宫。", "后山为门规禁地，弟子不得擅入，相传月夜有仙人在玉璧上舞剑。"]},
    "无量后山": {"type": "location", "region": "大理·无量山", "desc": "剑湖宫后的禁地，古木参天，藤萝密布，断崖之下云雾翻涌，崖对面一面石壁光洁如玉。",
                 "lore": ["此处为无量剑门规禁地，有弟子轮番巡守。", "断崖极高，崖底是一片湖泊（剑湖）与湖畔石洞，寻常无路可下。"]},
    "琅嬛福地": {"type": "location", "region": "大理·无量山后山崖底", "desc": "穿过湖畔石洞，是一座幽深石室，湖光自石隙透入，四壁生辉。",
                 "lore": ["此为逍遥派遗迹，久无人迹。", "石室中有一尊白玉雕成的宫装美女像，眼波流动，栩栩如生；像前有蒲团供人跪拜。", "玉像鞋上绣有字：「磕首千遍，供我驱使」「遵行我命，百死无悔」。"]},
    "大理城":   {"type": "location", "region": "大理国都", "desc": "苍山洱海之间的都城，镇南王府与天龙寺皆在左近。",
                 "lore": ["大理国以段氏为君，崇信佛法，皇族多有在天龙寺出家者。", "段氏绝学一阳指与六脉神剑名动天下，六脉神剑剑谱藏于天龙寺。"]},
    "万劫谷":   {"type": "location", "region": "大理·善人渡", "desc": "谷中林木森森，小径曲折，处处透着机关暗伏的阴冷。",
                 "lore": ["谷主钟万仇深恨段氏，谷口立誓：姓段者入此谷杀无赦。"]},
    "小镜湖":   {"type": "location", "region": "河南·信阳西北", "desc": "一泓碧水，竹林掩映，湖畔有方竹小屋，湖西有一座青石桥。",
                 "lore": ["段正淳的旧情人阮星竹隐居于此。"]},
    "聚贤庄":   {"type": "location", "region": "河南", "desc": "游氏兄弟的庄院，门庭开阔，常有江湖豪客往来。",
                 "lore": ["庄主游驹、游骥号称游氏双雄，好客仗义，常在庄中大宴天下英雄。"]},
    "少林寺":   {"type": "location", "region": "嵩山·少室山", "desc": "古刹巍峨，钟声悠远，武僧于塔林间练功不辍。",
                 "lore": ["少林为天下武学正宗，七十二绝技名闻天下。", "藏经阁为寺中重地，戒备森严。"]},
    "擂鼓山":   {"type": "location", "region": "河南·擂鼓山", "desc": "山谷中松林幽静，林间空地上摆着一张石几，几上是一局残棋。",
                 "lore": ["聪辩先生苏星河在此摆下珍珑棋局，广邀天下才俊前来破解。"]},
    "无锡城":   {"type": "location", "region": "江南·无锡", "desc": "江南名城，松鹤楼上酒香四溢，丐帮弟子在城中出没。",
                 "lore": ["丐帮为天下第一大帮，帮主乔峰威震江湖，与姑苏慕容并称「北乔峰，南慕容」。"]},
    "杏子林":   {"type": "location", "region": "江南·无锡城外", "desc": "城外一大片杏子林，枝叶繁茂，丐帮帮众常在此聚议。",
                 "lore": ["丐帮以长老与各袋弟子分统帮众，大事须在帮众大会上议决。"]},
    "燕子坞":   {"type": "location", "region": "江南·苏州太湖", "desc": "太湖中水道纵横，姑苏慕容氏的参合庄掩映在柳荫之后，非熟识者难至。",
                 "lore": ["姑苏慕容氏以「以彼之道，还施彼身」闻名天下。"]},
    "曼陀山庄": {"type": "location", "region": "江南·太湖小岛", "desc": "满岛遍植山茶（曼陀罗花），红白争艳，静得出奇。",
                 "lore": ["庄主王夫人厌恶男子，擅入的男子常被斩去手足作花肥。", "庄中琅嬛玉洞藏有天下武学典籍。"]},
    "缥缈峰":   {"type": "location", "region": "西域·天山", "desc": "峰顶云雾缭绕，铁索横空，灵鹫宫隐于其上。",
                 "lore": ["灵鹫宫以生死符辖制三十六洞、七十二岛群豪。"]},
    "雁门关":   {"type": "location", "region": "宋辽边境", "desc": "关隘雄峙，崖壁陡峭，朔风卷着沙砾扑面而来，关外即是辽境。",
                 "lore": ["三十年前雁门关外曾有一场惨烈伏击，其中隐情江湖鲜有人知。"]},

    "大理段氏": {"type": "faction", "desc": "大理国皇族，一阳指与六脉神剑为家传绝学。"},
