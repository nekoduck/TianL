    "逍遥派":   {"type": "faction", "desc": "隐秘门派，武学博大精深，江湖中几乎无人知晓。"},
    "灵鹫宫":   {"type": "faction", "desc": "天山之巅的神秘宫阙，统御群豪。"},
    "慕容氏":   {"type": "faction", "desc": "姑苏世家，燕国慕容氏之后。"},

    "段誉":     {"type": "person", "location": "剑湖宫", "status": "alive", "faction": "大理段氏", "title": "大理镇南王世子", "power": 5,
                 "persona": "书生意气，不喜武功，痴迷佛经与易经，见美貌女子便心生痴念；为人仁厚，言语迂腐。"},
